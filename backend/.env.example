PORT=8080
# PostgreSQL connection string (postgres://). Requires the pgvector
# extension for the embeddings table — see scripts/setup_postgres.sh.
DATABASE_URL=postgres://user:password@localhost:5432/skillmatch
JWT_SECRET=
# Comma-separated list of allowed browser origins (default http://localhost:5173)
CORS_ALLOWED_ORIGIN=http://localhost:5173

AWS_REGION=us-east-1
S3_BUCKET_NAME=

BEDROCK_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=gpt-5.6-sol

MCP_ENDPOINT=https://cockroachlabs.cloud/mcp
MCP_API_KEY=
MCP_CLUSTER_ID=
