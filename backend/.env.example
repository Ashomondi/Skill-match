PORT=8080
# PostgreSQL connection string (postgres://). Requires the pgvector
# extension for the embeddings table — see scripts/setup_postgres.sh
# or docker-compose.yml. Defaults match setup_postgres.sh.
DATABASE_URL=postgres://skillmatch:skillmatch@localhost:5432/skillmatch
# Optional. If unset, an ephemeral random secret is generated at startup
# (tokens are invalidated on restart).
JWT_SECRET=
# Comma-separated list of allowed browser origins (default http://localhost:5173)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Local-filesystem storage used when S3 is not configured. Resume files are
# stored under this directory with the same key layout as S3.
STORAGE_DIR=./data/resumes

# --- Object storage (S3 / MinIO / LocalStack) ---
# Leave S3_BUCKET_NAME empty to use local-filesystem storage instead.
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# For MinIO/LocalStack only:
# S3_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Amazon Bedrock (optional AI) ---
# Chat + CV tailoring and embeddings are disabled when BEDROCK_CHAT_MODEL_ID
# is unset; a local embedding provider is used as fallback.
BEDROCK_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0