PORT=8080
DATABASE_URL=
JWT_SECRET=

AWS_REGION=us-east-1
# S3-compatible store (MinIO): set S3_ENDPOINT + S3_ACCESS_KEY/S3_SECRET_KEY.
# For real AWS S3 leave S3_ENDPOINT empty and use AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# (or the default credential chain).
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Real AWS credentials for Bedrock (also used for S3 when S3_ENDPOINT is empty).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Chat model (Claude): e.g. anthropic.claude-sonnet-4-20250514
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=
# Embedding model: e.g. amazon.titan-embed-text-v2:0
BEDROCK_EMBED_MODEL_ID=

MCP_ENDPOINT=https://cockroachlabs.cloud/mcp
MCP_API_KEY=
MCP_CLUSTER_ID=
