PORT=8080
# PostgreSQL connection string (postgres://). Requires the pgvector
# extension for the embeddings table — see scripts/setup_postgres.sh.
DATABASE_URL=postgres://user:password@localhost:5432/skillmatch
JWT_SECRET=
# Comma-separated list of allowed browser origins (default http://localhost:5173)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Resume files are stored on the local filesystem under this directory and
# served by the backend at /storage.
STORAGE_DIR=./data/resumes

# Google Gemini powers the chat assistant and CV tailoring. Chat/tailor
# endpoints are only registered when GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
